{
  "datasets": [
    {
      "name": "10ccccd1",
      "displayName": "Match outcome distribution",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN home_club_goals > away_club_goals THEN 'Home Win'\n",
        "    WHEN home_club_goals < away_club_goals THEN 'Away Win'\n",
        "    ELSE 'Draw'\n",
        "  END AS result,\n",
        "  COUNT(*) AS matches,\n",
        "  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 1) AS pct\n",
        "FROM\n",
        "  workspace.gold.fact_game\n",
        "GROUP BY\n",
        "  1\n",
        "ORDER BY\n",
        "  2 DESC"
      ]
    },
    {
      "name": "ac5327bb",
      "displayName": "Transfer fee trend by year",
      "queryLines": [
        "SELECT d.year, AVG(t.transfer_fee) AS avg_fee, PERCENTILE_APPROX(t.transfer_fee, 0.5) AS median_fee\r\n",
        "FROM workspace.gold.fact_transfer t\r\n",
        "JOIN workspace.gold.dim_date d ON t.date_key = d.date_key\r\n",
        "WHERE t.transfer_type = 'paid' AND d.year BETWEEN 2010 AND 2025\r\n",
        "GROUP BY d.year\r\n",
        "ORDER BY d.year"
      ]
    },
    {
      "name": "a35b09a6",
      "displayName": "Player style cluster distribution",
      "queryLines": [
        "SELECT\n",
        "  cluster_label,\n",
        "  COUNT(*) AS players,\n",
        "  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 1) AS pct\n",
        "FROM\n",
        "  parquet.`/Volumes/workspace/transfermarkt/ml/player_style_clusters`\n",
        "GROUP BY\n",
        "  cluster_label\n",
        "ORDER BY\n",
        "  players DESC"
      ]
    },
    {
      "name": "2499c271",
      "displayName": "Top competitions by total goals",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN c.name = 'premier-league' THEN 'Premier League'\n",
        "    WHEN c.name = 'laliga' THEN 'La Liga'\n",
        "    WHEN c.name = 'serie-a' THEN 'Serie A'\n",
        "    WHEN c.name = 'bundesliga' THEN 'Bundesliga'\n",
        "    WHEN c.name = 'ligue-1' THEN 'Ligue 1'\n",
        "    WHEN c.name = 'eredivisie' THEN 'Eredivisie'\n",
        "    WHEN c.name = 'premier-liga' THEN 'Russian Premier League'\n",
        "    WHEN c.name = 'super-lig' THEN 'Süper Lig'\n",
        "    WHEN c.name = 'liga-portugal' THEN 'Liga Portugal'\n",
        "    WHEN c.name = 'jupiler-pro-league' THEN 'Belgian Pro League'\n",
        "    WHEN c.name = 'scottish-premiership' THEN 'Scottish Premiership'\n",
        "    WHEN c.name = 'super-league-1' THEN 'Super League 1'\n",
        "    WHEN c.name = 'superliga' THEN 'Superliga'\n",
        "    WHEN c.name = 'uefa-champions-league' THEN 'UEFA Champions League'\n",
        "    WHEN c.name = 'uefa-europa-league' THEN 'UEFA Europa League'\n",
        "    ELSE INITCAP(REPLACE(c.name, '-', ' '))\n",
        "  END AS competition,\n",
        "  SUM(a.goals) AS total_goals,\n",
        "  CASE\n",
        "    WHEN\n",
        "      c.name IN ('premier-league', 'laliga', 'serie-a', 'bundesliga', 'ligue-1')\n",
        "    THEN\n",
        "      'Top 5 League'\n",
        "    WHEN c.name IN ('uefa-champions-league', 'uefa-europa-league') THEN 'UEFA Competition'\n",
        "    ELSE 'Other League'\n",
        "  END AS category\n",
        "FROM\n",
        "  workspace.gold.fact_appearance a\n",
        "    JOIN workspace.gold.dim_competition c\n",
        "      ON a.competition_key = c.competition_key\n",
        "GROUP BY\n",
        "  1,\n",
        "  3\n",
        "ORDER BY\n",
        "  total_goals DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "97602e99",
      "displayName": "Transfer fee vs. age",
      "queryLines": [
        "SELECT\n",
        "  age_at_transfer,\n",
        "  EXP(log_transfer_fee) AS transfer_fee_eur,\n",
        "  CASE\n",
        "    WHEN age_at_transfer < 21 THEN 'Under 21'\n",
        "    WHEN age_at_transfer < 25 THEN '21-24'\n",
        "    WHEN age_at_transfer < 28 THEN '25-27'\n",
        "    WHEN age_at_transfer < 31 THEN '28-30'\n",
        "    ELSE 'Over 30'\n",
        "  END AS age_group\n",
        "FROM\n",
        "  parquet.`/Volumes/workspace/transfermarkt/ml/regression_features_final`\n",
        "WHERE\n",
        "  log_transfer_fee IS NOT NULL\n",
        "  AND age_at_transfer BETWEEN 16 AND 38"
      ]
    },
    {
      "name": "491f51a9",
      "displayName": "Models",
      "queryLines": [
        "SELECT * FROM VALUES\r\n",
        "  ('Classification', 'Random Forest', 'Macro F1', 0.479),\r\n",
        "  ('Regression', 'Linear Regression', 'R² (log space)', 0.760),\r\n",
        "  ('Clustering', 'K-Means (k=4)', 'Silhouette', 0.414)\r\n",
        "AS t(task, model, metric, value)"
      ]
    }
  ],
